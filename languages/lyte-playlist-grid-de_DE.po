msgid "LYTE Playlist Grid requires the active WP YouTube Lyte plugin."
msgstr "LYTE Playlist Grid benötigt das aktivierte Plugin WP YouTube Lyte."

msgid "Invalid or missing playlist ID."
msgstr "Ungültige oder fehlende Playlist-ID."

msgid "Please activate WP YouTube Lyte."
msgstr "Bitte WP YouTube Lyte aktivieren."

msgid "Add a YouTube API key in the WP YouTube Lyte settings first."
msgstr "Bitte zuerst einen YouTube-API-Key in den Einstellungen von WP YouTube Lyte hinterlegen."

#, python-format
msgid "Unable to load YouTube playlist: %s"
msgstr "YouTube-Playlist konnte nicht geladen werden: %s"

msgid "This playlist has no publicly accessible videos."
msgstr "Diese Playlist enthält keine öffentlich abrufbaren Videos."

msgid "Network error connecting to the YouTube API."
msgstr "Netzwerkfehler bei der Verbindung zur YouTube-API."

#, python-format
msgid "YouTube API error (HTTP %d). Check the API key and permissions."
msgstr "YouTube-API-Fehler (HTTP %d). Bitte API-Key und Berechtigungen prüfen."

msgid "Invalid response from the YouTube API."
msgstr "Ungültige Antwort der YouTube-API."

msgid "Playlist exceeds 1,000 entries; the safety limit was reached."
msgstr "Playlist mit mehr als 1.000 Einträgen: Sicherheitsgrenze erreicht."


msgid "Deactivate the old Technickr LYTE Playlist Grid plugin to avoid duplicate shortcode registrations."
msgstr "Bitte das alte Plugin Technickr LYTE Playlist Grid deaktivieren, um doppelte Shortcode-Registrierungen zu vermeiden."
